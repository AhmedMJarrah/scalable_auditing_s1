# Windows checkouts otherwise commit CRLF and every diff looks like a rewrite.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.db    binary
