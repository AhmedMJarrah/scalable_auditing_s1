# --- virtualenv -------------------------------------------------------
s1/
.venv/
venv/
env/


# --- secrets ----------------------------------------------------------
.env
.env.*
!.env.example
*.pem
credentials*.json
token*.json
service_account*.json

# --- data (legislative data must never reach GitHub) ------------------
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# --- logs -------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log
*.jsonl

# --- reports / exports ------------------------------------------------
reports/*
!reports/.gitkeep
*.xlsx
*.docx

# --- python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / os -----------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
